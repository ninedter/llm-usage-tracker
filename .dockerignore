# Build artifacts
node_modules
.next
dist-electron
build
electron/*.js
*.tsbuildinfo

# Data and secrets — never bake into image layers; mounted/passed at runtime
.data
.docker-data
credentials.enc.json
.env*

# Repo noise
.git
.claude
.superpowers
docs
hooks
*.md
.DS_Store

# edge shipper: runs on the machine, not inside the hub image
edge

# Tests never run in the image, and `next build` typechecks every .ts in the
# context — edge-contract.test.ts imports edge/, which is excluded above
**/__tests__
**/*.test.ts
